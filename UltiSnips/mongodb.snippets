snippet upsertMany "upsertMany" b
docs.map(function(doc) {
  console.log(\`doc: \` + doc.id.toString('hex').replace(/^(.{8})(.{4})(.{4})(.{4})(.{12})$/, '\$1-\$2-\$3-\$4-\$5'))
  db.${1:Collection}.replaceOne(
    { id: doc.id },
    doc,
    { upsert: true, },
  )
})
endsnippet

snippet deleteMany "" b
docs.map(function(doc) {
