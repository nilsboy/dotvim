snippet groupDistinct "distinct" b
{
  $group:
  {
    id: [ $1, ],
    doc: { $first: "$$ROOT" },
  },
},
{
  $replaceRoot:
  {
    newRoot: "$doc"
  }
},
endsnippet

snippet groupByArrayField "groupByArrayField" b
{
  $addFields:
  {
    "${1:pathToArray}._root": "$$ROOT",
  },
},
{
  $unwind: { path: "$$1" },
},
{
  $match:
  {
    "$1.${2:match field}": "${3:match value}"
  }
},
{
  $group: {
    id: "$$1.${4:group field}",
    _root: { $first: "$productCharacteristic._root" },
  },
},
{
  $replaceRoot:
  {
    newRoot: "$_root"
  }
},
endsnippet

snippet grepDb "grep whole db - careful!" b
db.getCollectionNames().forEach(function(collectionName) {
  db.getCollection(collectionName).find().forEach(function(doc) {
    var json = JSON.stringify(doc)
    if (json.match(/${0:regex}$0/i) == null) {
      return
    }
    printjson(doc)
  })
})
endsnippet

snippet grep "grep" b
db.${1:collectionName}.find().forEach(function(doc) {
  var json = JSON.stringify(doc)
  if (json.match(/${VISUAL}$2$0/i) == null) {
    return
  }
  count++
  printjson(doc)
})
endsnippet

snippet grep2 "grep2" b
if (json.match(/$1/i) == null) {
  return
}$0
endsnippet

snippet csv "csv" w
.map(function(doc) { count++; return doc; }).forEach(function(doc) {
    const keys = Object.keys(doc).sort()
    const header = keys.join(";")
    if(first) {
      first = 0
      print()
      print(header)
      gHeader = header
    }
    if(gHeader != header) {
      throw new Error("header mismatch: " + header + " / " + gHeader)
    }
    const values = []
    for(const key of keys) {
      values.push(doc[key])
    }
    print(values.join(";"))
})
endsnippet

