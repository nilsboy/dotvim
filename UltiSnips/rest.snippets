snippet init "init" b
# default url
http://localhost:8080

# default vars
id = ...

# NOTE: env vars need to be exported in the shell first: 'export APIKEY=xxx'
apikey = $APIKEY
x-key: :apikey

--
--

--
GET /activate?id=:id
endsnippet

snippet post "post" b
--
POST /
{
  $0
}

endsnippet

snippet headerAuthBearer "" w
Authorization: Bearer ey
endsnippet

snippet headerApiKey "apikey" b
X-API-KEY: ${VISUAL}$0
endsnippet

snippet get "get" b
--
GET /
endsnippet

snippet headerContenttypeTextHtml "headerContenttypeTextHtml" b
Content-Type: text/html; charset=UTF-8
endsnippet

snippet headerAccept "headerAccept" b
Accept:application/sparql-results+json
endsnippet

snippet headerContentTypeUrlEncoded "headerContentTypeUrlEncoded" b
Content-Type: application/x-www-form-urlencoded
endsnippet

snippet sparql "sparql" b
--
Content-Type: application/x-www-form-urlencoded
POST /sparql
query=
CONSTRUCT WHERE { ?s ?p ?o . }
endsnippet

snippet passwordAuth "password" b
basicAuth
endsnippet

snippet basicAuth "basic auth" b
-u ${1:login}:${0:password}
endsnippet

snippet h1 "" b
--
### $1
--
$0
endsnippet

snippet h2 "" b
--
#### $1
--
$0
endsnippet

snippet : "" w
"$1": "$0",
endsnippet  
