snippet s "String" w
"${1:key}": "${2:value}",$0
endsnippet

snippet n "Number" b
"${1:key}": ${2:value},$0
endsnippet

snippet a "Array" b
[
  ${VISUAL}$0
],
endsnippet

snippet na "Named array" b
"${1:key}": [
  ${VISUAL}$0
],
endsnippet

snippet o "Object" b
{
  ${VISUAL}$0
},
endsnippet

snippet no "Named object" b
"${1:key}": {
  ${VISUAL}$0
},
endsnippet

snippet null "Null" b
"${0:key}": null,
endsnippet

snippet b "Bool" b
"${1:key}": $2`!v SnCompB(2, ['true', 'false'])`,
endsnippet

snippet pm2_package_json "pm2_package_json" b
"scripts": {
  "setup": "npm install",
  "start": "pm2 start pm2.json",
	"stop": "pm2 delete pm2.json",
  "restart": "pm2 restart pm2.json",
  "status": "pm2 ls pm2.json",
  "logs": "pm2 logs --lines 100 pm2.json",
  "monitor": "pm2 monit pm2.json",
  "dev": "bash bin/app.sh -d"
	"dev": "npm stop ; pm2 start pm2.json --watch"
},
endsnippet

snippet exclude-tsconfig "" w
"exclude": ["node_modules", "dist", "out", "legacy", "vendor", "vitest", "docs"],
endsnippet
