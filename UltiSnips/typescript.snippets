  next(
    ...args: [] | [undefined]
  ): IteratorResult<$1, any> {
    if (!this.iterator) {
      this.iterator = this.dto[Symbol.iterator]()
    }
    const next = this.iterator.next()
    return {
      value: new $1(next.value),
      done: next.done,
    }
  }

  toArray(): ${1:`!p snip.rv = classNameSingular(snip)`}[] {
    return Array.from(this)
  }

  length(): number {
