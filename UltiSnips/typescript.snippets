snippet toBoolean "toBoolean" b
function toBoolean(value: string, defaultValue: boolean) {
  if (value === null || value === undefined || value === ``) {
    return defaultValue
  }
  if (value.match(/^(true)$/i)) {
    return true
  }
  if (value.match(/^(false)$/i)) {
    return false
  }
  throw new Error(`Invalid boolean: '${value}'`)
}
endsnippet

