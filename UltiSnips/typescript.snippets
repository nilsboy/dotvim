snippet notes "notes" b
# enable jumps src of dependencies:

package.json:
  "resolutions": {
    "@my/module": "link:../my-module",
  }

tsconfig.json:
{
  "compilerOptions": {
    "composite": true // necessary? TODO / NOTE: also in tsconfig.base.json?
    "declaration": true,
    "declarationMap": true,
    }
}

then run in the root project to compile the root and dep projects:
tsc -b --watch

// another possibility

  "references": [
    {
      "path": "../models-mongoose"
    }
  ]

class-transformer:
  @Transform(({ value }) =>
    value
      .toString()
      .split(',')
      .map((x: string) => x.trim()),
  )

// overwrite vulnerable dependencies
{
  "resolutions": {
    "socks": "^2.8.3",
    "express": "^4.21.1"
  }
}
endsnippet

