### Misc

# comments
snippet // "multiline comment" w
/**
 * ${VISUAL}$0
 */
endsnippet

snippet node "node shebang" b
#!/usr/bin/env node

// ${1:TODO: description}

$0
endsnippet

snippet bash "bash shebang" b
#!/usr/bin/env bash

# ${1:TODO Description}

set -e
set -o pipefail

$0
endsnippet

snippet perl "perl shebang" b
#!/usr/bin/env perl

# ${1:TODO Description}

use strict;
use warnings;
no warnings 'uninitialized';
use Data::Dumper;
use utf8;
# binmode('STDOUT', 'utf-8')

$0
endsnippet

snippet date "YYYY-MM-DD" w
(`!v strftime("%F")`)
endsnippet

snippet dateIsoUtc "iso date utc with timezone" w
`date --utc "+%Y-%m-%dT%H:%M:%SZ"`
endsnippet

snippet 2fa "run 2fa" w
`2fa`
endsnippet

# NOTE: timezone should be +1 or +2 depending on summertime
