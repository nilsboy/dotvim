# We use a little hack so that the snippet is expanded
# and parsed correctly

snippet snip "" w
`!v "snippet"` ${1:Tab_trigger} "" ${4:w}
${VISUAL}$0
`!v "endsnippet"`
endsnippet

# \$\{VISUAL${1:${2:default}${3:/transform/}}\}
snippet vis "${VISUAL}" i
\$\{VISUAL\}
endsnippet

snippet $ "" w
\$\{$1:${VISUAL}$2\}$0
endsnippet

snippet 0 "$0" i
\$0
endsnippet

snippet q "q" w
`$0`
endsnippet

snippet "`" "`" rA
\\`
endsnippet

snippet ' "'" i
\\`
endsnippet

snippet v "vim call" w
\`!v $0\`
endsnippet

snippet debug "vim call" w
\`!v DebugId()\`
endsnippet
